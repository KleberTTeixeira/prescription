@page "/receitas/nova"
@page "/receitas/{Id:int}/editar"
@inject PrescriptionApiClient PrescriptionApi
@inject CatalogApiClient CatalogApi
@inject TemplateApiClient TemplateApi
@inject FavoriteApiClient FavoriteApi
@inject MedicationApiClient MedicationApi
@inject ILoggedProfessionalStore LoggedProfessional
@inject IClock Clock
@inject NavigationManager Navigation

@* Create / edit a prescription (ECF.10.01, ECF.10.02, ECF.10.03, ECF.10.10). *@
<PageTitle>@(Id is null ? "Nova receita" : "Editar receita")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Href="@BackHref" Icon="@Icons.Material.Filled.ArrowBack" aria-label="Voltar" />
    <MudText Typo="Typo.h5" data-testid="title">@(Id is null ? "Nova receita" : $"Editar receita nº {Id}")</MudText>
</MudStack>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="load-error">@_loadError</MudAlert>
}
else if (_blocked is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="blocked">@_blocked</MudAlert>
    <MudButton Href="@($"receitas/{Id}")" Variant="Variant.Outlined" Color="Color.Primary">Visualizar receita</MudButton>
}
else if (!_loaded)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
    <span class="d-none" data-testid="loading">Carregando...</span>
}
else
{
    <div class="form-body">
        <MudPaper Elevation="1" Class="pa-5 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Dados da receita</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudSelect T="uint?" Label="Cliente" Value="_draft.ClientId" ValueChanged="v => _draft.ClientId = v"
                               Variant="Variant.Outlined" Error="ClientError is not null" ErrorText="@ClientError" data-testid="client">
                        @foreach (var client in _clients)
                        {
                            <MudSelectItem T="uint?" Value="client.Id">@client.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="uint?" Label="Local de atendimento" Value="_draft.InstitutionId"
                               ValueChanged="v => _draft.InstitutionId = v" Variant="Variant.Outlined"
                               Error="InstitutionError is not null" ErrorText="@InstitutionError" data-testid="institution">
                        @foreach (var institution in _institutions)
                        {
                            <MudSelectItem T="uint?" Value="institution.Id">@institution.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Class="d-block mb-1">Formato</MudText>
                    <MudToggleGroup T="PrescriptionFormat" Value="_draft.Format" ValueChanged="ChangeFormatAsync"
                                    Color="Color.Primary" Outlined="true" CheckMark="false" data-testid="format">
                        <MudToggleItem Value="PrescriptionFormat.Structured" Text="Estruturada (itens)" />
                        <MudToggleItem Value="PrescriptionFormat.Unstructured" Text="Não estruturada (texto livre)" />
                    </MudToggleGroup>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="PrescriptionCategory" Label="Categoria" Value="_draft.Category"
                               ValueChanged="v => _draft.Category = v" Variant="Variant.Outlined" data-testid="category">
                        @foreach (var category in Enum.GetValues<PrescriptionCategory>())
                        {
                            <MudSelectItem T="PrescriptionCategory" Value="category">@category.ToLabel()</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_suggestedCategory is { } suggested)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                 Icon="@Icons.Material.Filled.AutoAwesome" Class="mt-2" data-testid="suggested-category">
                            Sugerida pelo sistema: @suggested.ToLabel()
                        </MudChip>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ECF.10.01 / ECF.10.02 *@
        <MudPaper Elevation="1" Class="pa-5 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">@(_draft.Format == PrescriptionFormat.Unstructured ? "Texto da receita" : "Observação geral")</MudText>
            @if (_templates.Count > 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudSelect T="uint?" Label="Texto padrão" @bind-Value="_templateId" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width: 360px" data-testid="template">
                        @foreach (var template in _templates)
                        {
                            <MudSelectItem T="uint?" Value="template.Id">@template.Title</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentPaste"
                               OnClick="UseTemplate" data-testid="use-template">Usar texto padrão</MudButton>
                </MudStack>
            }
            <MudTextField T="string" Label="@(_draft.Format == PrescriptionFormat.Unstructured ? "Texto da receita" : "Observação geral (opcional)")"
                          @bind-Value="_draft.FreeText" Lines="5" Variant="Variant.Outlined"
                          Error="FreeTextError is not null" ErrorText="@FreeTextError" data-testid="free-text" />
        </MudPaper>

        @* ECF.10.03 *@
        @if (_draft.Format == PrescriptionFormat.Structured)
        {
            <MudPaper Elevation="1" Class="pa-5 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Medicamentos</MudText>
                @if (_favorites.Count > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3" data-testid="favorites">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Favoritos:</MudText>
                        @foreach (var favorite in _favorites)
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Star"
                                     OnClick="() => ChooseFavoriteAsync(favorite)" data-testid="favorite">@favorite.DisplayName</MudChip>
                        }
                    </MudStack>
                }

                <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
                    @for (var index = 0; index < _items.Count; index++)
                    {
                        var i = index;
                        var row = _items[i];
                        var item = row.Item;
                        <MudExpansionPanel @bind-Expanded="row.Expanded" data-testid="item">
                            <TitleContent>
                                <div class="d-flex align-center" style="width: 100%">
                                    <MudText><b>Item @(i + 1) – @(item.MedicationName.Length > 0 ? item.MedicationName : "(sem medicamento)")</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">@Summary(item)</MudText>
                                    <MudSpacer />
                                    <MudTooltip Text="Remover item">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => RemoveItemAsync(i)" aria-label="Remover item" data-testid="remove-item" />
                                    </MudTooltip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @if (item.MedicationId is not null)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Medication" Color="Color.Primary" />
                                        <MudText><b data-testid="medication-name">@item.MedicationName</b></MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@FormName(item.PharmaceuticalFormId)</MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   OnClick="() => ClearMedicationAsync(item)">Trocar medicamento</MudButton>
                                    </MudStack>
                                }
                                else if (item.NotRegistered)
                                {
                                    <MudGrid Spacing="2" Class="mb-3">
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" Label="Medicamento não cadastrado" @bind-Value="item.MedicationName"
                                                          Variant="Variant.Outlined" Error="Missing(item.MedicationName)"
                                                          ErrorText="@ItemError(item, "Medicamento")" data-testid="medication-not-registered" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudSelect T="uint?" Label="Forma farmacêutica" @bind-Value="item.PharmaceuticalFormId"
                                                       Variant="Variant.Outlined" Error="Missing(item.PharmaceuticalFormId)"
                                                       ErrorText="@ItemError(item, "Forma farmacêutica")">
                                                @foreach (var form in _pharmaceuticalForms)
                                                {
                                                    <MudSelectItem T="uint?" Value="form.Id">@form.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="2" Class="d-flex align-center">
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => ClearMedicationAsync(item)">Buscar no cadastro</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <MedicationSearch OnSelected="m => ChooseMedicationAsync(item, m)" />
                                        @if (MedicationError(item) is { } error)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-3">@error</MudText>
                                        }
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1" StartIcon="@Icons.Material.Filled.EditNote"
                                                   OnClick="() => MarkNotRegisteredAsync(item)" data-testid="not-registered">Medicamento não cadastrado</MudButton>
                                    </div>
                                }

                                <MudGrid Spacing="2">
                                    <MudItem xs="6" md="2">
                                        <MudNumericField T="decimal?" Label="Dose" Culture="AppCulture.PtBr" Format="0.###" @bind-Value="item.Dose" Min="0"
                                                         HideSpinButtons="true" Variant="Variant.Outlined" Error="DoseInvalid(item)"
                                                         ErrorText="@(DoseInvalid(item) ? "Campo 'Dose' deve ser maior que zero." : null)" data-testid="dose" />
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudSelect T="uint?" Label="Unidade" @bind-Value="item.DoseUnitId" Variant="Variant.Outlined"
                                                   Error="Missing(item.DoseUnitId)" ErrorText="@ItemError(item, "Unidade")">
                                            @foreach (var unit in _doseUnits)
                                            {
                                                <MudSelectItem T="uint?" Value="unit.Id">@unit.Abbreviation – @unit.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="uint?" Label="Frequência" @bind-Value="item.FrequencyId" Variant="Variant.Outlined"
                                                   Error="Missing(item.FrequencyId)" ErrorText="@ItemError(item, "Frequência")">
                                            @foreach (var frequency in _frequencies)
                                            {
                                                <MudSelectItem T="uint?" Value="frequency.Id">@frequency.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="uint?" Label="Via de administração" @bind-Value="item.AdministrationRouteId"
                                                   Variant="Variant.Outlined" Error="Missing(item.AdministrationRouteId)"
                                                   ErrorText="@ItemError(item, "Via de administração")">
                                            @foreach (var route in _administrationRoutes)
                                            {
                                                <MudSelectItem T="uint?" Value="route.Id">@route.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudDatePicker Label="Início" Culture="AppCulture.PtBr" Date="ToDateTime(item.StartDate)"
                                                       DateChanged="d => item.StartDate = ToDateOnly(d)" DateFormat="dd/MM/yyyy"
                                                       Editable="true" Variant="Variant.Outlined" Error="Missing(item.StartDate)"
                                                       ErrorText="@ItemError(item, "Início")" data-testid="start-date" />
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudNumericField T="int?" Label="Duração (dias)" Culture="AppCulture.PtBr" @bind-Value="item.DurationDays"
                                                         Min="1" HideSpinButtons="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" md="3" Class="d-flex align-center">
                                        <MudCheckBox T="bool" Label="Uso contínuo" @bind-Value="item.IsContinuousUse" Color="Color.Primary" />
                                    </MudItem>
                                    <MudItem xs="6" md="4">
                                        <MudDatePicker Label="Usar até (prazo)" Culture="AppCulture.PtBr" Date="ToDateTime(item.UsageDeadline)"
                                                       DateChanged="d => item.UsageDeadline = ToDateOnly(d)" DateFormat="dd/MM/yyyy"
                                                       Editable="true" Clearable="true" Variant="Variant.Outlined" data-testid="usage-deadline" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Observação" @bind-Value="item.Notes" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>

                <MudStack Row="true" Class="mt-3">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="() => AddItem()" data-testid="add-item">Adicionar medicamento</MudButton>
                </MudStack>
            </MudPaper>
        }

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="errors">
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </MudAlert>
        }
    </div>

    <div class="form-footer no-print">
        <MudButton Href="@BackHref" Variant="Variant.Outlined" Color="Color.Primary">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving" OnClick="SaveAsync" data-testid="save">Salvar</MudButton>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    /// <summary>Item of the screen and whether its panel is open.</summary>
    private sealed class ItemRow(PrescriptionItemDraft item, bool expanded)
    {
        public PrescriptionItemDraft Item { get; } = item;
        public bool Expanded { get; set; } = expanded;
    }

    private PrescriptionDraft _draft = new();
    private readonly List<ItemRow> _items = [];
    private MedicalPrescription? _prescription;
    private IReadOnlyList<Client> _clients = [];
    private IReadOnlyList<Institution> _institutions = [];
    private IReadOnlyList<Lookup> _pharmaceuticalForms = [];
    private IReadOnlyList<Lookup> _administrationRoutes = [];
    private IReadOnlyList<DoseUnit> _doseUnits = [];
    private IReadOnlyList<Lookup> _frequencies = [];
    private IReadOnlyList<Template> _templates = [];
    private IReadOnlyList<Medication> _favorites = [];
    private uint? _templateId;
    private PrescriptionCategory? _suggestedCategory;
    private bool _loaded;
    private string? _loadError;
    private string? _blocked;
    private IReadOnlyList<string> _errors = [];
    /// <summary>After the first "Salvar": required fields show their message below the field.</summary>
    private bool _submitted;
    private bool _saving;

    private string BackHref => Id is null ? "receitas" : $"receitas/{Id}";

    /// <summary>Base of the usage deadline and default start: issue date of the prescription (today for a new one).</summary>
    private DateOnly IssueDate => _prescription is null ? Clock.Today : DateOnly.FromDateTime(_prescription.IssuedAt);

    private string? ClientError => _submitted && _draft.ClientId is null ? "Campo 'Cliente' é obrigatório." : null;
    private string? InstitutionError => _submitted && _draft.InstitutionId is null ? "Campo 'Instituição' é obrigatório." : null;
    private string? FreeTextError =>
        _submitted && _draft.Format == PrescriptionFormat.Unstructured && string.IsNullOrWhiteSpace(_draft.FreeText)
            ? "Receita não estruturada exige texto livre."
            : null;

    private bool Missing(object? value) => _submitted && (value is null || value is string text && string.IsNullOrWhiteSpace(text));
    private bool DoseInvalid(PrescriptionItemDraft item) => _submitted && item.Dose is null or <= 0;
    private static string ItemError(PrescriptionItemDraft item, string field) => $"Campo '{field}' é obrigatório.";
    private string? MedicationError(PrescriptionItemDraft item) =>
        _submitted && item.MedicationId is null && !item.NotRegistered ? "Campo 'Medicamento' é obrigatório." : null;

    /// <summary>"1,5 cp, 8/8 horas, Oral" (shown in the closed panel).</summary>
    private string Summary(PrescriptionItemDraft item)
    {
        var parts = new List<string>();
        if (item.Dose is { } dose)
        {
            var unit = _doseUnits.FirstOrDefault(u => u.Id == item.DoseUnitId)?.Abbreviation;
            parts.Add($"{AppCulture.Number(dose)} {unit}".Trim());
        }
        parts.AddRange(new[]
        {
            _frequencies.FirstOrDefault(f => f.Id == item.FrequencyId)?.Name,
            _administrationRoutes.FirstOrDefault(r => r.Id == item.AdministrationRouteId)?.Name
        }.OfType<string>());
        return parts.Count == 0 ? "" : "· " + string.Join(", ", parts);
    }

    private bool _parametersSet;
    private int? _loadedId;

    /// <summary>
    /// "/receitas/nova" and "/receitas/{Id}/editar" use this same component: when the address changes Blazor keeps
    /// the component and only changes Id, so the screen is cleared and loaded again for the new address.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_parametersSet && _loadedId == Id)
        {
            return;
        }
        _parametersSet = true;
        _loadedId = Id;
        ClearScreen();
        await LoadScreenAsync();
    }

    private void ClearScreen()
    {
        _draft = new PrescriptionDraft();
        _items.Clear();
        _prescription = null;
        _templateId = null;
        _suggestedCategory = null;
        _loaded = false;
        _loadError = null;
        _blocked = null;
        _errors = [];
        _submitted = false;
        _saving = false;
    }

    private async Task LoadScreenAsync()
    {
        try
        {
            var clients = CatalogApi.GetClientsAsync();
            var institutions = CatalogApi.GetInstitutionsAsync();
            var forms = CatalogApi.GetPharmaceuticalFormsAsync();
            var routes = CatalogApi.GetAdministrationRoutesAsync();
            var units = CatalogApi.GetDoseUnitsAsync();
            var frequencies = CatalogApi.GetFrequenciesAsync();
            var templates = TemplateApi.ListAsync();
            var favorites = FavoriteApi.ListAsync();
            Task<MedicalPrescription>? prescription = Id is { } id ? PrescriptionApi.GetAsync((uint)id) : null;

            (_clients, _institutions, _pharmaceuticalForms, _administrationRoutes, _doseUnits, _frequencies) =
                (await clients, await institutions, await forms, await routes, await units, await frequencies);
            _templates = await templates;
            _favorites = await favorites;
            Load(prescription is null ? null : await prescription);
            _loaded = true;
        }
        catch (ApiException exception)
        {
            _loadError = exception.Message;
        }
    }

    private void Load(MedicalPrescription? prescription)
    {
        if (prescription is null)
        {
            AddItem();
            return;
        }
        if (prescription.IsIssued)
        {
            _blocked = "Receita já emitida (impressa) não pode ser alterada.";
            return;
        }
        if (prescription.ProfessionalId != LoggedProfessional.Current?.Id)
        {
            _blocked = "Receita pertence a outro profissional.";
            return;
        }
        _prescription = prescription;
        _draft = PrescriptionDraft.From(prescription);
        _items.AddRange(_draft.Items.Select(item => new ItemRow(item, expanded: false)));
        if (_draft.Format == PrescriptionFormat.Structured && _draft.Items.Count == 0)
        {
            AddItem();
        }
    }

    private string FormName(uint? id) => _pharmaceuticalForms.FirstOrDefault(form => form.Id == id)?.Name ?? "";

    private async Task ChangeFormatAsync(PrescriptionFormat format)
    {
        _draft.Format = format;
        if (format == PrescriptionFormat.Structured && _draft.Items.Count == 0)
        {
            AddItem();
        }
        await SuggestCategoryAsync();
    }

    /// <summary>ECF.10.02 – the standard text is copied to the free text, which stays editable.</summary>
    private void UseTemplate()
    {
        if (_templates.FirstOrDefault(template => template.Id == _templateId) is { } template)
        {
            _draft.FreeText = template.Content;
        }
    }

    private PrescriptionItemDraft AddItem()
    {
        var item = new PrescriptionItemDraft { StartDate = IssueDate };
        _draft.Items.Add(item);
        _items.Add(new ItemRow(item, expanded: true));
        return item;
    }

    private async Task RemoveItemAsync(int index)
    {
        _draft.Items.RemoveAt(index);
        _items.RemoveAt(index);
        await SuggestCategoryAsync();
    }

    /// <summary>Catalog medication: name and form from the catalog; usage deadline suggested by the API (ECF.10.03).</summary>
    private async Task ChooseMedicationAsync(PrescriptionItemDraft item, Medication medication)
    {
        item.MedicationId = medication.Id;
        item.NotRegistered = false;
        item.MedicationName = medication.DisplayName;
        item.PharmaceuticalFormId = medication.PharmaceuticalFormId;
        item.UsageDeadline = null;
        try
        {
            item.UsageDeadline = await MedicationApi.SuggestUsageDeadlineAsync(medication.Id, IssueDate);
        }
        catch (ApiException exception)
        {
            _errors = [exception.Message];
        }
        await SuggestCategoryAsync();
    }

    /// <summary>ECF.10.10 – favorite of the logged professional: goes to the first item without medication (or a new item).</summary>
    private async Task ChooseFavoriteAsync(Medication favorite)
    {
        var item = _draft.Items.FirstOrDefault(i => i.MedicationId is null && !i.NotRegistered) ?? AddItem();
        foreach (var row in _items)
        {
            row.Expanded = row.Item == item;
        }
        await ChooseMedicationAsync(item, favorite);
    }

    /// <summary>Medication not in the catalog: name and form typed; no suggested deadline.</summary>
    private async Task MarkNotRegisteredAsync(PrescriptionItemDraft item)
    {
        item.ClearMedication();
        item.NotRegistered = true;
        await SuggestCategoryAsync();
    }

    private async Task ClearMedicationAsync(PrescriptionItemDraft item)
    {
        item.ClearMedication();
        await SuggestCategoryAsync();
    }

    /// <summary>Suggested by the system (controlled > antimicrobial > common); the user can change it.</summary>
    private async Task SuggestCategoryAsync()
    {
        var ids = _draft.CatalogMedicationIds();
        try
        {
            // No catalog medication (unstructured or only not registered): Common.
            var category = ids.Count == 0 ? PrescriptionCategory.Common : await PrescriptionApi.SuggestCategoryAsync(ids);
            _suggestedCategory = category;
            _draft.Category = category;
        }
        catch (ApiException exception)
        {
            _errors = [exception.Message];
        }
    }

    private async Task SaveAsync()
    {
        _submitted = true;
        _errors = _draft.Validate();
        if (_errors.Count > 0)
        {
            // Open the panels of the items with errors.
            for (var i = 0; i < _items.Count; i++)
            {
                if (_errors.Any(error => error.StartsWith($"Item {i + 1}: ")))
                {
                    _items[i].Expanded = true;
                }
            }
            return;
        }
        _saving = true;
        try
        {
            var request = _draft.ToRequest();
            var saved = Id is { } id
                ? await PrescriptionApi.UpdateAsync((uint)id, request)
                : await PrescriptionApi.CreateAsync(request);
            Navigation.NavigateTo($"receitas/{saved.Id}");
        }
        catch (ApiException exception)
        {
            _errors = [exception.Message];
            _saving = false;
        }
    }

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);

    private static DateOnly? ToDateOnly(DateTime? date) => date is { } value ? DateOnly.FromDateTime(value) : null;
}
