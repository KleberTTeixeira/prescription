<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- integration/ and blazor/ are separate projects (Prescription.IntegrationTests, Prescription.Blazor.Tests). -->
  <ItemGroup>
    <Compile Remove="integration\**" />
    <EmbeddedResource Remove="integration\**" />
    <None Remove="integration\**" />
    <Compile Remove="blazor\**" />
    <EmbeddedResource Remove="blazor\**" />
    <None Remove="blazor\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\business\Prescription.Application\Prescription.Application.csproj" />
    <ProjectReference Include="..\business\Prescription.Domain\Prescription.Domain.csproj" />
  </ItemGroup>

</Project>
